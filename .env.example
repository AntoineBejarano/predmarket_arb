LOG_LEVEL=INFO
SIGNAL_THRESHOLD=0.08
RUN_HOURS=168
BINANCE_BASE_URL=https://api.binance.com
GAMMA_API_URL=https://gamma-api.polymarket.com
# Mercados 5m: slug (recomendado) o scan (paginación + filtro texto)
# GAMMA_FETCH_MODE=slug
# GAMMA_SLUG_CACHE_SEC=15
# Precios: polymarket (RTDS crypto_prices + Binance solo BNB) o binance (los 5 REST)
# PRICE_FEED=polymarket
# POLYMARKET_WS_URL=wss://ws-live-data.polymarket.com
# Cada N ciclos de muestreo RTDS (p.ej. 10 × 30s ≈ 5 min) log INFO con últimos precios WS
# RTDS_SAMPLE_LOG_EVERY_N=10
AUTO_START=true
PORT=8080
DASHBOARD_PASSWORD=changeme
# Puerto interno del health de validate_edge (subprocess); no debe coincidir con PORT del API
# VALIDATOR_HEALTH_PORT=18088
# GAMMA_MAX_PAGES=200
# DATA_DIR=.
# Strategy lab: override default output for compact eval / freeze / go-no-go scripts
# PM_STRATEGY_EXPERIMENT_DIR=strategies/crypto_5m_updown/experiments/exogenous_compact

# Arb Engine
DRY_RUN=true
# Capital ficticio paper por estrategia (notional «EUR» = misma magnitud que USDC del CLOB; ROI = pnl_cum / capital)
ARB_FICT_CAPITAL_EUR=1000
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=
# Opcional: proxy/Gnosis (ver docs Polymarket); por defecto EOA
# POLY_SIGNATURE_TYPE=0
# POLY_FUNDER=
# POLYGON_CHAIN_ID=137
KALSHI_API_KEY=
KALSHI_API_SECRET=
MAX_DAILY_DRAWDOWN=0.08
# Por defecto en código es true; pon false solo si quieres desactivar el bloque experimental en arb_engine.
ENABLE_EXPERIMENTAL=true
ARB_START_CAPITAL=10000
ARB_CURRENT_CAPITAL=10000

# Bundle Arb
BUNDLE_MIN_EDGE=0.025
BUNDLE_MIN_OUTCOMES=2
BUNDLE_MAX_SIZE_USDC=300
BUNDLE_POLL_INTERVAL=10
BUNDLE_MAX_OUTCOMES=8
BUNDLE_MAX_PAGES=5
BUNDLE_GAS_PER_LEG=0.012
BUNDLE_MAX_GAS_PER_TX=0.05
# Descubrimiento: gamma_events (Gamma /events/keyset negRisk), gamma, clob_simplified, clob_full
BUNDLE_DISCOVERY=gamma_events
# BUNDLE_MODE=taker_scan
# maker_first: policy + quoter (misma q) + reconcile; POST solo con BUNDLE_MAKER_LIVE=true
# BUNDLE_MAKER_LIVE=false
# BUNDLE_TARGET_BUNDLE_USDC=50
# BUNDLE_MAX_OUTCOMES_LIVE=4
# BUNDLE_POST_ONLY=true
# BUNDLE_ORDER_TYPE=GTD
# BUNDLE_ORDER_TTL_SECONDS=180
# BUNDLE_RECONCILE_FAIL_MAX_CYCLES=3
# BUNDLE_REQUIRE_NEGRISK=true
# BUNDLE_ALLOW_AUGMENTED_NEGRISK=false
# BUNDLE_MIN_DAYS_TO_EXPIRY=14
# BUNDLE_MAX_DAYS_TO_EXPIRY=365
# BUNDLE_GAMMA_EVENTS_MAX_PAGES=20
# BUNDLE_GAMMA_EVENTS_LIMIT=50
# Filtros nativos Gamma (closed, end_date_*, liquidity_*, volume_*) por defecto;
# solo si hiciera falta el query no documentado:
# BUNDLE_GAMMA_KEYSET_LEGACY_ACTIVE=false
# BUNDLE_GAMMA_MARKETS_LEGACY_ACTIVE=false
# BUNDLE_GAMMA_MAX_PAGES=30
# BUNDLE_GAMMA_LIMIT=100
# BUNDLE_MIN_LIQUIDITY_USD=0
# BUNDLE_MIN_VOLUME_24H=0
# BUNDLE_MIN_LIQUIDITY_CLOB=0
# Gamma events: liquidez/volumen mínimos a nivel evento (0 = desactivado)
# BUNDLE_MIN_HOURS_TO_RES=0
# BUNDLE_SIMPLIFIED_MAX_PAGES=5
# BUNDLE_MAX_CANDIDATES_PER_CYCLE=120
# BUNDLE_TARGET_SIZE_USDC=50
# BUNDLE_USE_VWAP=false
# BUNDLE_MIN_DEPTH_PER_LEG_USDC=0
# BUNDLE_EXEC_BUFFER_PER_LEG=0.0025
# BUNDLE_EXCLUDE_NEG_RISK=true
# BUNDLE_USE_WS=false
# BUNDLE_WS_WARMUP_SEC=0.35
# MARKETS_CACHE_TTL_SEC=45
# MARKET_META_CACHE_TTL_SEC=600
# CLOB_RATE_LIMIT_RPS=0
# CLOB_RETRY_MAX=3
# CLOB_RETRY_BASE_MS=200

# Cross Exchange
CROSS_MIN_EDGE=0.030
CROSS_MAX_SIZE_USDC=200
CROSS_MAX_LOCKUP_DAYS=21
CROSS_POLL_INTERVAL=30
CROSS_POLY_FEE=0.002
CROSS_KALSHI_FEE=0.002

# Market Maker
MM_GAMMA=0.1
MM_K=2.0
MM_MIN_SPREAD=0.04
MM_MAX_INVENTORY=50
MM_QUOTE_INTERVAL=30
MM_MAX_PAGES=3

# Combinatorial / Term / Latency
COMBO_SCAN_INTERVAL=60
TERM_SCAN_INTERVAL=300
TERM_MIN_MISPRICING=0.15
LAT_POLL_INTERVAL=15
LAT_TICK_THRESHOLD=0.003
LAT_MAX_SIZE_USDC=150
LAT_SYMBOLS=BTCUSDT,ETHUSDT

# Latency Arb — Sports (cargada por defecto con el bloque experimental del arb_engine)
LATENCY_SPORTS_MIN_EDGE=0.03
LATENCY_SPORTS_SPORTS=soccer_epl,basketball_nba,americanfootball_nfl
LATENCY_SPORTS_POLL_INTERVAL=5
LATENCY_SPORTS_MAX_STAKE_USDC=50
LATENCY_SPORTS_REGIONS=eu
# TTL descubrimiento Gamma (s); default y mínimo efectivo 300 — no negociable en código
LATENCY_SPORTS_DISCOVERY_TTL=300
# ODDS_API_KEY=  # preferido; si vacío se usa clave LAB en clients/odds_api.py
# LATENCY_SPORTS_GAMMA_TAG_ID=
# LATENCY_SPORTS_GAMMA_MAX_PAGES=8
