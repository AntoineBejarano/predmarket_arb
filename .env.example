LOG_LEVEL=INFO
SIGNAL_THRESHOLD=0.08
RUN_HOURS=168
BINANCE_BASE_URL=https://api.binance.com
GAMMA_API_URL=https://gamma-api.polymarket.com
# Mercados 5m: slug (recomendado) o scan (paginación + filtro texto)
# GAMMA_FETCH_MODE=slug
# GAMMA_SLUG_CACHE_SEC=15
# Precios: polymarket (RTDS crypto_prices + Binance solo BNB) o binance (los 5 REST)
# PRICE_FEED=polymarket
# POLYMARKET_WS_URL=wss://ws-live-data.polymarket.com
# Cada N ciclos de muestreo RTDS (p.ej. 10 × 30s ≈ 5 min) log INFO con últimos precios WS
# RTDS_SAMPLE_LOG_EVERY_N=10
AUTO_START=true
PORT=8080
DASHBOARD_PASSWORD=changeme
# Puerto interno del health de validate_edge (subprocess); no debe coincidir con PORT del API
# VALIDATOR_HEALTH_PORT=18088
# GAMMA_MAX_PAGES=200
# DATA_DIR=.
# Strategy lab: override default output for compact eval / freeze / go-no-go scripts
# PM_STRATEGY_EXPERIMENT_DIR=strategies/crypto_5m_updown/experiments/exogenous_compact

# Arb Engine
DRY_RUN=true
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=
# Opcional: proxy/Gnosis (ver docs Polymarket); por defecto EOA
# POLY_SIGNATURE_TYPE=0
# POLY_FUNDER=
# POLYGON_CHAIN_ID=137
KALSHI_API_KEY=
KALSHI_API_SECRET=
MAX_DAILY_DRAWDOWN=0.08
ENABLE_EXPERIMENTAL=false
ARB_START_CAPITAL=10000
ARB_CURRENT_CAPITAL=10000

# Bundle Arb
BUNDLE_MIN_EDGE=0.025
BUNDLE_MAX_SIZE_USDC=300
BUNDLE_POLL_INTERVAL=10
BUNDLE_MAX_OUTCOMES=5
BUNDLE_MAX_PAGES=5
BUNDLE_GAS_PER_LEG=0.012
BUNDLE_MAX_GAS_PER_TX=0.05

# Cross Exchange
CROSS_MIN_EDGE=0.030
CROSS_MAX_SIZE_USDC=200
CROSS_MAX_LOCKUP_DAYS=21
CROSS_POLL_INTERVAL=30
CROSS_POLY_FEE=0.002
CROSS_KALSHI_FEE=0.002

# Market Maker
MM_GAMMA=0.1
MM_K=2.0
MM_MIN_SPREAD=0.04
MM_MAX_INVENTORY=50
MM_QUOTE_INTERVAL=30
MM_MAX_PAGES=3

# Combinatorial / Term / Latency
COMBO_SCAN_INTERVAL=60
TERM_SCAN_INTERVAL=300
TERM_MIN_MISPRICING=0.15
LAT_POLL_INTERVAL=15
LAT_TICK_THRESHOLD=0.003
LAT_MAX_SIZE_USDC=150
LAT_SYMBOLS=BTCUSDT,ETHUSDT
